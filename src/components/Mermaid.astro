---
interface Props {
	code: string;
}

const { code } = Astro.props;
---

<div class="relative group mermaid-wrapper my-4">
	<div class="mermaid-block flex justify-center bg-[var(--card-bg)] rounded-xl p-4 md:p-6 border border-black/10 dark:border-white/5 shadow-md overflow-x-auto" data-mermaid-code={code}>
		<div class="animate-pulse w-full h-32 flex items-center justify-center text-sm text-[var(--text-color-light)]">
			Rendering diagram...
		</div>
	</div>
	<button
		type="button"
		class="mermaid-fullscreen-btn absolute bottom-3 right-3 p-1.5 rounded-lg bg-black/5 dark:bg-white/5 hover:bg-black/10 dark:hover:bg-white/10 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 opacity-0 group-hover:opacity-100 transition-colors duration-200 focus:opacity-100 border border-black/5 dark:border-white/5"
		title="全屏放大"
		aria-label="全屏放大图表"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="15 3 21 3 21 9"></polyline>
			<polyline points="9 21 3 21 3 15"></polyline>
			<line x1="21" y1="3" x2="14" y2="10"></line>
			<line x1="3" y1="21" x2="10" y2="14"></line>
		</svg>
	</button>
</div>

<style is:global>
.mermaid-wrapper {
	--mermaid-surface: var(--mermaid-normal-fill, var(--btn-regular-bg));
	--mermaid-surface-alt: var(--btn-plain-bg-hover);
	--mermaid-text: var(--mermaid-normal-text, var(--btn-content));
	--mermaid-line: var(--mermaid-normal-stroke, var(--meta-divider));
	--mermaid-note-fill: var(--mermaid-startend-fill, var(--btn-regular-bg));
	--mermaid-note-stroke: var(--mermaid-startend-stroke, var(--primary));
	--mermaid-note-text: var(--mermaid-startend-text, var(--btn-content));
	content-visibility: auto;
	contain-intrinsic-size: auto 250px;
}

.mermaid-block,
.mermaid-block * {
	transition: none !important;
}

.mermaid-block > svg {
	display: block;
	max-width: 100%;
	height: auto;
}


@media (max-width: 640px) {
	.mermaid-dialog-shell {
		padding: 2.75rem 1rem 1rem;
	}
}

</style>

<script>
	import React from "react";
	import { dialog } from "@/components/ui/surface";
	import MermaidDialog from "@/components/react/dialogs/MermaidDialog";

	type MermaidApi = typeof import("mermaid")["default"];

	const CUSTOM_STYLE_ATTRIBUTE = "data-mermaid-custom-style";
	let mermaidPromise: Promise<MermaidApi> | null = null;
	let observer: IntersectionObserver | null = null;
	let swupHookRegistered = false;

	function getMermaid(): Promise<MermaidApi> {
		if (!mermaidPromise) {
			mermaidPromise = import("mermaid").then(({ default: mermaid }) => {
				mermaid.setParseErrorHandler((err: unknown) => {
					console.warn("Mermaid syntax error:", err);
				});
				mermaid.initialize({
					startOnLoad: false,
					theme: "base",
					securityLevel: "loose",
				});
				return mermaid;
			});
		}
		return mermaidPromise;
	}

	function getCustomClassNames(code: string): Set<string> {
		const names = new Set<string>();
		const classDefinition = /^\s*classDef\s+([^\s;]+)\s+/gm;
		let match = classDefinition.exec(code);
		while (match) {
			for (const name of match[1].split(",")) {
				if (name) names.add(name);
			}
			match = classDefinition.exec(code);
		}
		return names;
	}

	function markCustomStyledElements(svg: SVGElement, code: string): void {
		const customClassNames = getCustomClassNames(code);
		if (customClassNames.size === 0) return;

		for (const element of svg.querySelectorAll("[class]")) {
			for (const className of customClassNames) {
				if (element.classList.contains(className)) {
					element.setAttribute(CUSTOM_STYLE_ATTRIBUTE, "true");
					break;
				}
			}
		}
	}

	function applyThemeProperties(svg: SVGElement, selector: string, properties: Record<string, string>): void {
		for (const element of svg.querySelectorAll<SVGElement | HTMLElement>(selector)) {
			for (const [property, value] of Object.entries(properties)) {
				element.style.setProperty(property, value, "important");
			}
		}
	}

	function applyThemeStyles(svg: SVGElement): void {
		const custom = `:not([${CUSTOM_STYLE_ATTRIBUTE}])`;
		const rules: Array<[string, Record<string, string>]> = [
			[
				".label, .nodeLabel, .edgeLabel, .edgeLabel p, .cluster-label, .cluster-label span, .messageText, .labelText, .loopText, .sectionTitle, .classTitle, .classTitleText, .state-title, .stateLabel, .statediagramTitleText, g.classGroup text, g.stateGroup text",
				{ fill: "var(--mermaid-text)", color: "var(--mermaid-text)" },
			],
			[
				`.node${custom} rect, .node${custom} circle, .node${custom} ellipse, .node${custom} polygon, .node${custom} path, g.classGroup${custom} rect, g.stateGroup${custom} rect, .statediagram-state${custom} rect, .actor, .labelBox, .activation0, .activation1, .activation2, g rect.rect, .classLabel .box, .stateLabel .box`,
				{ fill: "var(--mermaid-surface)", stroke: "var(--mermaid-line)" },
			],
			[
				".cluster rect, .statediagram-cluster rect, .stateGroup .composit, .stateGroup .alt-composit",
				{ fill: "var(--mermaid-surface-alt)", stroke: "var(--mermaid-line)" },
			],
			[".edgeLabel rect, .labelBkg", { fill: "var(--card-bg)", background: "var(--card-bg)" }],
			[
				".edgePath .path, .flowchart-link, .relation, .transition, .actor-line, .messageLine0, .messageLine1, .loopLine, g.classGroup line, g.stateGroup line, .divider, .note-edge",
				{ stroke: "var(--mermaid-line)" },
			],
			[
				'.marker, .arrowheadPath, [id$="-arrowhead"] path, [id$="-barbEnd"] path, [id$="-compositionStart"], [id$="-compositionEnd"], [id$="-dependencyStart"], [id$="-dependencyEnd"]',
				{ fill: "var(--mermaid-line)", stroke: "var(--mermaid-line)" },
			],
			[
				'[id$="-extensionStart"], [id$="-extensionEnd"], [id$="-aggregationStart"], [id$="-aggregationEnd"], [id$="-lollipopStart"], [id$="-lollipopEnd"]',
				{ fill: "var(--mermaid-surface)", stroke: "var(--mermaid-line)" },
			],
			[".note, .state-note, .statediagram-note rect", { fill: "var(--mermaid-note-fill)", stroke: "var(--mermaid-note-stroke)" }],
			[
				".noteText, .noteText tspan, .state-note text, .statediagram-note text, .statediagram-note .nodeLabel",
				{ fill: "var(--mermaid-note-text)", color: "var(--mermaid-note-text)" },
			],
			[".node circle.state-start, .node circle.state-end, .node .fork-join", { fill: "var(--mermaid-line)", stroke: "var(--mermaid-line)" }],
			[".end-state-inner", { fill: "var(--card-bg)", stroke: "var(--card-bg)" }],
			[
				".normal rect, .normal circle, .normal ellipse, .normal polygon, .normal path",
				{ fill: "var(--mermaid-normal-fill)", stroke: "var(--mermaid-normal-stroke)" },
			],
			[
				".normal text, .normal tspan, .normal .label, .normal .nodeLabel",
				{ fill: "var(--mermaid-normal-text)", color: "var(--mermaid-normal-text)" },
			],
			[
				".critical rect, .critical circle, .critical ellipse, .critical polygon, .critical path",
				{ fill: "var(--mermaid-critical-fill)", stroke: "var(--mermaid-critical-stroke)" },
			],
			[
				".critical text, .critical tspan, .critical .label, .critical .nodeLabel",
				{ fill: "var(--mermaid-critical-text)", color: "var(--mermaid-critical-text)" },
			],
			[
				".startEnd rect, .startEnd circle, .startEnd ellipse, .startEnd polygon, .startEnd path",
				{ fill: "var(--mermaid-startend-fill)", stroke: "var(--mermaid-startend-stroke)" },
			],
			[
				".startEnd text, .startEnd tspan, .startEnd .label, .startEnd .nodeLabel",
				{ fill: "var(--mermaid-startend-text)", color: "var(--mermaid-startend-text)" },
			],
			[".actorNode rect, .actorNode circle, .actorNode ellipse, .actorNode polygon, .actorNode path", { fill: "none", stroke: "none" }],
		];

		for (const [selector, properties] of rules) {
			applyThemeProperties(svg, selector, properties);
		}
	}

	function addThemeStyles(svgMarkup: string, code: string): string {
		const template = document.createElement("template");
		template.innerHTML = svgMarkup.trim();
		const svg = template.content.querySelector("svg");
		if (!(svg instanceof SVGElement)) return svgMarkup;

		svg.classList.add("mermaid-svg");
		markCustomStyledElements(svg, code);
		applyThemeStyles(svg);
		return svg.outerHTML;
	}

	function showRenderError(block: HTMLElement, message: string): void {
		const error = document.createElement("div");
		error.className = "text-red-500 text-sm p-4 bg-red-100 dark:bg-red-950 border border-red-200 dark:border-red-900 rounded-xl font-mono whitespace-pre-wrap";
		error.setAttribute("role", "alert");
		error.textContent = message;
		block.replaceChildren(error);
		block.dataset.processed = "true";
	}

	async function renderBlock(block: HTMLElement): Promise<void> {
		if (block.dataset.processed || block.dataset.rendering) return;
		const code = block.getAttribute("data-mermaid-code");
		if (!code) return;

		block.dataset.rendering = "true";
		try {
			const mermaid = await getMermaid();
			const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
			const { svg } = await mermaid.render(id, code);
			if (svg.includes('id="mermaid-error') || svg.includes('class="error') || svg.includes("Syntax error")) {
				showRenderError(block, "Mermaid Syntax Error: Please check your diagram syntax.");
				return;
			}

			block.innerHTML = addThemeStyles(svg, code);
			block.dataset.processed = "true";
		} catch (error) {
			console.error("Failed to render Mermaid diagram:", error);
			showRenderError(block, `Unable to render this diagram: ${error instanceof Error ? error.message : String(error)}`);
		} finally {
			delete block.dataset.rendering;
		}
	}

	function getObserver(): IntersectionObserver {
		if (!observer) {
			observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer?.unobserve(entry.target);
					void renderBlock(entry.target as HTMLElement);
				}
			}, { rootMargin: "200px 0px" });
		}
		return observer;
	}

	function renderMermaid(): void {
		const lazyObserver = getObserver();
		for (const block of document.querySelectorAll<HTMLElement>(".mermaid-block:not([data-processed]):not([data-rendering])")) {
			lazyObserver.observe(block);
		}
	}

	async function openFullscreen(button: HTMLElement): Promise<void> {
		const block = button.closest(".mermaid-wrapper")?.querySelector<HTMLElement>(".mermaid-block");
		const svg = block?.querySelector<SVGElement>("svg");
		if (!block || !svg) return;

		const svgString = svg.outerHTML;
		await dialog.custom((close) => React.createElement(MermaidDialog, { svgString, close }));
	}

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const button = target.closest<HTMLElement>(".mermaid-fullscreen-btn");
		if (button) openFullscreen(button);
	});

	function registerSwupHook(): void {
		if (swupHookRegistered || !window.swup?.hooks) return;
		swupHookRegistered = true;
		window.swup.hooks.on("page:view", () => {
			renderMermaid();
		});
	}

	renderMermaid();
	if (window.swup) registerSwupHook();
	else document.addEventListener("swup:enable", registerSwupHook, { once: true });
</script>
