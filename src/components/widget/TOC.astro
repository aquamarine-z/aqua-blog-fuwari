---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { stripBasePath } from "../../utils/url-utils";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}

const className = Astro.props.class;
const isPostsRoute = stripBasePath(Astro.url.pathname).startsWith("/posts/");

const removeTailingHash = (text: string) => {
	let lastIndexOfHash = text.lastIndexOf("#");
	if (lastIndexOfHash !== text.length - 1) {
		return text;
	}

	return text.substring(0, lastIndexOfHash);
};

let heading1Count = 1;

const maxLevel = siteConfig.toc.depth;
---
{headings.length > 0 &&
<table-of-contents class:list={[className, "group block relative"]}>
    {headings.filter((heading) => heading.depth < minDepth + maxLevel).map((heading) =>
            <a href={`#${heading.slug}`} class="px-2 flex gap-2 relative transition w-full min-h-9 rounded-xl
        hover:bg-[var(--toc-btn-hover)] active:bg-[var(--toc-btn-active)] py-2
    ">
                <div class:list={["transition w-5 h-5 shrink-0 rounded-lg text-xs flex items-center justify-center font-bold",
                    {
                        "bg-[var(--toc-badge-bg)] text-[var(--btn-content)]": heading.depth == minDepth,
                        "ml-4": heading.depth == minDepth + 1,
                        "ml-8": heading.depth == minDepth + 2,
                    }
                ]}
                >
                    {heading.depth == minDepth && heading1Count++}
                    {heading.depth == minDepth + 1 && <div class="transition w-2 h-2 rounded-[0.1875rem] bg-[var(--toc-badge-bg)]"></div>}
                    {heading.depth == minDepth + 2 && <div class="transition w-1.5 h-1.5 rounded-sm bg-black/5 dark:bg-white/10"></div>}
                </div>
                <div class:list={["transition text-sm", {
                    "text-50": heading.depth == minDepth || heading.depth == minDepth + 1,
                    "text-30": heading.depth == minDepth + 2,
                }]}>{removeTailingHash(heading.text)}</div>
            </a>
    )}
    <div class="active-indicator" style="opacity: 0" class:list={[{'hidden': headings.length == 0}, "-z-10 absolute bg-[var(--toc-btn-hover)] left-0 right-0 rounded-xl transition-all " +
        "group-hover:bg-transparent border-2 border-[var(--toc-btn-hover)] group-hover:border-[var(--toc-btn-active)] border-dashed"]}></div>
</table-of-contents>}

<script>
class TableOfContents extends HTMLElement {
    tocEl: HTMLElement | null = null;
    visibleClass = "visible";
    observer: IntersectionObserver;
    anchorNavTarget: HTMLElement | null = null;
    headingIdxMap = new Map<string, number>();
    headings: HTMLElement[] = [];
    sections: HTMLElement[] = [];
    tocEntries: HTMLAnchorElement[] = [];
    active: boolean[] = [];
    activeIndicator: HTMLElement | null = null;
    updateFrameId: number | null = null;
    activeRangeKey = "";
    entryTops: number[] = [];
    entryBottoms: number[] = [];
    geometryDirty = true;
    articleEl: HTMLElement | null = null;
    animatedHeightTargets = new Set<EventTarget>();
    resizeObserver = new ResizeObserver(() => {
        this.geometryDirty = true;
    });

    constructor() {
        super();
        this.observer = new IntersectionObserver(
            this.markVisibleSection, { threshold: 0 }
        );
    };

    markVisibleSection = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
            const id = entry.target.children[0]?.getAttribute("id");
            const idx = id ? this.headingIdxMap.get(id) : undefined;
            if (idx != undefined)
                this.active[idx] = entry.isIntersecting;

            if (entry.isIntersecting && this.anchorNavTarget == entry.target.firstChild)
                this.anchorNavTarget = null;
        });

        this.update();
    };

    toggleActiveHeading = (min: number, max: number) => {
        for (let i = 0; i < this.tocEntries.length; i++) {
            this.tocEntries[i].classList.toggle(
                this.visibleClass,
                min <= i && i <= max,
            );
        }

        if (min > max) {
            this.activeIndicator?.setAttribute("style", `opacity: 0`);
        } else {
            const top = this.entryTops[min];
            const bottom = this.entryBottoms[max];
            this.activeIndicator?.setAttribute("style", `top: ${top}px; height: ${bottom - top}px`);
        }
    };

    scrollToActiveHeading = (min: number, max: number) => {
        // If the TOC widget can accommodate both the topmost
        // and bottommost items, scroll to the topmost item. 
        // Otherwise, scroll to the bottommost one.

        if (this.anchorNavTarget || !this.tocEl || min > max) return;
        const tocHeight = this.tocEl.clientHeight;
        const activeHeight = this.entryBottoms[max] - this.entryTops[min];

        let top;
        if (activeHeight < 0.9 * tocHeight)
            top = this.entryTops[min] - 32;
        else
            top = this.entryTops[max] - tocHeight * 0.8;

        this.tocEl.scrollTo({
            top,
            left: 0,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "auto"
                : "smooth",
        });
    };

    update = () => {
        if (this.animatedHeightTargets.size > 0) return;
        if (this.updateFrameId !== null) return;

        this.updateFrameId = requestAnimationFrame(() => {
            this.updateFrameId = null;

            if (this.animatedHeightTargets.size > 0) return;
            if (!this.active.includes(true)) this.fallback();

            const min = this.active.indexOf(true);
            const max = this.active.lastIndexOf(true);
            const nextActiveRangeKey = `${min}:${max}`;

            if (
                nextActiveRangeKey === this.activeRangeKey &&
                !this.anchorNavTarget &&
                !this.geometryDirty
            )
                return;

            this.activeRangeKey = nextActiveRangeKey;
            this.refreshEntryGeometry();
            this.toggleActiveHeading(min, max);
            this.scrollToActiveHeading(min, max);
        });
    };

    refreshEntryGeometry = () => {
        if (!this.geometryDirty) return;

        this.entryTops = new Array(this.tocEntries.length);
        this.entryBottoms = new Array(this.tocEntries.length);
        for (let i = 0; i < this.tocEntries.length; i++) {
            const entry = this.tocEntries[i];
            const top = entry.offsetTop;
            this.entryTops[i] = top;
            this.entryBottoms[i] = top + entry.offsetHeight;
        }
        this.geometryDirty = false;
    };

    handleArticleTransitionRun = (event: TransitionEvent) => {
        if (event.propertyName !== "height" || !event.target) return;

        this.animatedHeightTargets.add(event.target);
        if (this.updateFrameId !== null) {
            cancelAnimationFrame(this.updateFrameId);
            this.updateFrameId = null;
        }
    };

    handleArticleTransitionEnd = (event: TransitionEvent) => {
        if (event.propertyName !== "height" || !event.target) return;

        this.animatedHeightTargets.delete(event.target);
        if (this.animatedHeightTargets.size === 0) this.update();
    };

    fallback = () => {
        if (!this.sections.length) return;

        for (let i = 0; i < this.sections.length; i++) {
            const { top: offsetTop, bottom: offsetBottom } =
                this.sections[i].getBoundingClientRect();

            if (this.isInRange(offsetTop, 0, window.innerHeight)
                || this.isInRange(offsetBottom, 0, window.innerHeight)
                || (offsetTop < 0 && offsetBottom > window.innerHeight)) {                    
                this.markActiveHeading(i);
            }
            else if (offsetTop > window.innerHeight) break;
        }
    };

    markActiveHeading = (idx: number)=> {
        this.active[idx] = true;
    };

    handleAnchorClick = (event: Event) => {
        const anchor = event
            .composedPath()
            .find((element) => element instanceof HTMLAnchorElement);

        if (anchor) {
            const id = decodeURIComponent(anchor.hash?.substring(1));
            const idx = this.headingIdxMap.get(id);
            if (idx !== undefined) {
                this.anchorNavTarget = this.headings[idx];
            } else {
                this.anchorNavTarget = null;
            }
        }
    };

    isInRange(value: number, min: number, max: number) {
        return min < value && value < max;
    };

    connectedCallback() {
        let initialized = false;
        const init = () => {
            if (initialized) return;
            initialized = true;
            this.init();
        };

        const element = document.querySelector('.prose');
        if (element) {
            const animations = element.getAnimations();
            if (animations && animations.length > 0) {
                Promise.all(animations.map(a => a.finished)).then(init).catch(init);
            } else {
                element.addEventListener('animationend', init, { once: true });
            }
        }
        // Fallback: always init after 500ms max to prevent getting stuck
        setTimeout(init, 500);
    };

    init() {
        this.tocEl = this.closest('.toc-scroll-container') || this.parentElement; // The container that scrolls

        if (!this.tocEl) return;

        this.tocEl.addEventListener("click", this.handleAnchorClick, {
            capture: true,
        });

        this.activeIndicator = this.querySelector(".active-indicator");

        this.tocEntries = Array.from(
            this.querySelectorAll<HTMLAnchorElement>("a[href^='#']")
        );

        if (this.tocEntries.length === 0) return;

        this.sections = new Array(this.tocEntries.length);
        this.headings = new Array(this.tocEntries.length);
        for (let i = 0; i < this.tocEntries.length; i++) {
            const id = decodeURIComponent(this.tocEntries[i].hash?.substring(1));
            const heading = document.getElementById(id);
            const section = heading?.parentElement;
            if (heading instanceof HTMLElement && section instanceof HTMLElement) {
                this.headings[i] = heading;
                this.sections[i] = section;
                this.headingIdxMap.set(id, i);
            }
        }
        this.active = new Array(this.tocEntries.length).fill(false);

        this.articleEl = document.querySelector<HTMLElement>('.prose');
        this.articleEl?.addEventListener('transitionrun', this.handleArticleTransitionRun);
        this.articleEl?.addEventListener('transitionend', this.handleArticleTransitionEnd);
        this.articleEl?.addEventListener('transitioncancel', this.handleArticleTransitionEnd);
        this.resizeObserver.observe(this);

        this.sections.forEach((section) =>
            this.observer.observe(section)
        );

        this.fallback();
        this.update();
    };

    disconnectedCallback() {
        if (this.updateFrameId !== null) {
            cancelAnimationFrame(this.updateFrameId);
            this.updateFrameId = null;
        }
        this.sections.forEach((section) =>
            this.observer.unobserve(section)
        );
        this.observer.disconnect();
        this.resizeObserver.disconnect();
        this.articleEl?.removeEventListener('transitionrun', this.handleArticleTransitionRun);
        this.articleEl?.removeEventListener('transitionend', this.handleArticleTransitionEnd);
        this.articleEl?.removeEventListener('transitioncancel', this.handleArticleTransitionEnd);
        this.animatedHeightTargets.clear();
        this.tocEl?.removeEventListener("click", this.handleAnchorClick);
    };
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>
